# Origen del backend (SIN "/api": client.js lo agrega).
#   Desarrollo: vacío -> las peticiones van a /api y Vite las redirige al backend con el proxy
#               de vite.config.js (así no hace falta CORS).
#   Producción: origen completo, p. ej. https://api.midominio.com  (el backend debe permitir ese origen con CORS)
VITE_API_URL=

# Solo desarrollo: a dónde redirige Vite las rutas /api y /uploads. Debe coincidir con el PORT del backend
# (su valor por defecto es 3001).
VITE_PROXY_TARGET=http://localhost:3001

# Enlace a la póliza de seguro del club (se abre en una pestaña nueva en el perfil del atleta).
VITE_POLIZA_URL=
